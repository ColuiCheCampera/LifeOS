DATABASE_URL=postgresql://lifeos:lifeos@localhost:5432/lifeos
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret
ALLOWED_GOOGLE_SUB=your-google-subject
ALLOWED_EMAIL=you@example.com
# openssl rand -base64 32 (exactly 32 decoded bytes)
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DEMO_MODE=false
# Enable only with a publicly reachable HTTPS AUTH_URL for Google callbacks.
CALENDAR_PUSH_ENABLED=false
